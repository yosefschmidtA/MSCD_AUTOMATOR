#!/bin/bash

function usage() {
    echo "Uso: ./run opcao"
    echo "Opção pode assumir os seguintes valores:"
    echo "  dev - executa o projeto no modo desenvolvimento (http://localhost:5000)"
    echo "  prod - executa o projeto no modo produção (http://10.0.1.145:60010)"
    echo "  build - compila o projeto e o contêiner Docker"
    echo "  down - derruba os contêiners"
    echo "  logs - exibe os logs da aplicação"
    exit 1
}

OPTION=$1

if [[ -z "$OPTION" ]]; then
    usage
fi

# A omicron so tem o binario docker-compose, sem o plugin "docker compose".
if docker compose version &> /dev/null; then
    COMPOSE="docker compose"
elif command -v docker-compose &> /dev/null; then
    COMPOSE="docker-compose"
else
    echo "Nenhum Docker Compose encontrado: instale o plugin 'docker compose' ou o 'docker-compose'."
    exit 1
fi

# Externa no compose.yml (ver o comentario la): o compose nao cria, entao cria aqui.
REDE="mscd_automator_mscd-network"
if [[ $OPTION == "dev" || $OPTION == "prod" ]]; then
    docker network inspect "$REDE" &> /dev/null || docker network create "$REDE" > /dev/null
fi

if [[ $OPTION == "dev" ]]; then
    echo "Executando a configuração de desenvolvimento..."
    $COMPOSE -f compose.yml -f compose.dev.yml up -d
    echo "Sucesso!"
elif [[ $OPTION == "prod" ]]; then
    echo "Executando a configuração de produção..."
    $COMPOSE -f compose.yml -f compose.prod.yml up -d
    echo "Sucesso!"
elif [[ $OPTION == "down" ]]; then
    echo "Parando a aplicação..."
    $COMPOSE down --remove-orphans
elif [[ $OPTION == "build" ]]; then
    echo "Buildando os contêineres..."
    # Na omicron o BuildKit guardou um DNS vazio no boot (o Docker subiu antes do
    # resolv.conf) e falha em "lookup registry-1.docker.io on [::1]:53" ate o
    # Docker ser reiniciado. O construtor classico usa o DNS atual.
    if ! DOCKER_BUILDKIT=1 $COMPOSE -f compose.yml build; then
        echo "Build com BuildKit falhou; tentando o construtor clássico..."
        DOCKER_BUILDKIT=0 $COMPOSE -f compose.yml build
    fi
elif [[ $OPTION == "logs" ]]; then
    $COMPOSE logs -f
else
    usage
fi
